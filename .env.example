# Copy to .env.local and fill in values from your Supabase project (Settings → API).
# These two values are PUBLIC (they ship to the browser). Security is enforced by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put the service_role key in any VITE_* variable or anywhere in this repo.
